{
  description = "CertiCoq-Wasm testing environment";
  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-utils.url = "github:numtide/flake-utils";
  };
  outputs =
    {
      self,
      nixpkgs,
      flake-utils,
    }:
    flake-utils.lib.eachDefaultSystem (
      system:
      let
        lib = nixpkgs.lib;
        pkgs = import nixpkgs {
          inherit system;
          config.allowUnfreePredicate =
            pkg:
            builtins.elem (lib.getName pkg) [
              "compcert"
            ];
        };

        # Upstream nixpkgs only knows about released CertiRocq/MetaRocq/coq-wasm, which
        # don't fit the branch we want to test, so pin all three here.
        rocqPackages = pkgs.rocqPackages_9_1.overrideScope (
          self: super: {
            # CertiRocq needs the unreleased MetaRocq 9.1 branch
            # (e.g. MetaRocq.Erasure.EImplementLazyForce, missing in 1.5.1-9.1)
            metarocq = super.metarocq.override {
              version = {
                version = "9.1-c8cd460";
                location = {
                  rev = "c8cd46054518193103c3bb33aa6e15c7f489e72c";
                  hash = "sha256-Lcr6B4gYSS57zVinn+e2tk1Kfy9XzJs+sd3CTuSTvX0=";
                };
              };
            };

            # CertiRocq wants coq-wasm >= 2.2.1, nixpkgs defaults to 2.2.0 on Rocq 9.1
            wasmcert = super.wasmcert.override { version = "2.2.1"; };

            CertiRocq =
              (super.CertiRocq.override {
                # https://github.com/womeier/certirocq/tree/wasm-constr-store-offsets
                version = {
                  version = "wasm-constr-store-offsets";
                  location = {
                    owner = "womeier";
                    rev = "288629eb9f1a8c2576de184e95dc0298407ebfff";
                    hash = "sha256-4LCWhzJFrCPTI4OuEcZLYt0WQ0cHOL7vVZ0uKkI8DyU=";
                  };
                };
              }).overrideAttrs
                (old: {
                  # the plugin _CoqProject/mlpack files are generated by a python script now
                  nativeBuildInputs = old.nativeBuildInputs ++ [ pkgs.python3 ];

                  # the plugins moved from {plugin,cplugin} to plugins/{plugin,cplugin}
                  installPhase = ''
                    runHook preInstall

                    OUTDIR=$out/lib/coq/${self.coq.coq-version}/user-contrib

                    DST=$OUTDIR/CertiRocq/Plugin/runtime make -C runtime install
                    COQLIBINSTALL=$OUTDIR make -C theories install
                    COQLIBINSTALL=$OUTDIR make -C libraries install
                    COQLIBINSTALL=$OUTDIR COQPLUGININSTALL=$OCAMLFIND_DESTDIR make -C plugins/plugin install
                    COQLIBINSTALL=$OUTDIR COQPLUGININSTALL=$OCAMLFIND_DESTDIR make -C plugins/cplugin install

                    runHook postInstall
                  '';
                });
          }
        );
        rocq-core = rocqPackages.rocq-core;
        certirocq = rocqPackages.CertiRocq;

        # wasmtime CLI (used to AOT-compile the modules) and the Python bindings
        # need to have the same version.
        wasmtime = pkgs.wasmtime;
        wasmtime-py = pkgs.python3Packages.wasmtime.overridePythonAttrs (old: {
          version = wasmtime.version;
          src = old.src; # keep the wasmtime-py tag the hash belongs to
          postPatch = old.postPatch + ''
            echo "${wasmtime.version}" > VERSION
          '';
        });

        python3 = pkgs.python3.withPackages (ps: [
          wasmtime-py
          ps.click
          ps.tqdm
        ]);

        wasm-benchmarks = pkgs.stdenv.mkDerivation {
          pname = "certirocq-wasm-benchmarks";
          inherit (certirocq) version src;

          nativeBuildInputs = [
            rocq-core
            certirocq
          ];

          dontConfigure = true;
          enableParallelBuilding = true;

          buildPhase = ''
            runHook preBuild

            # upstream's Makefiles call coqc/coq_makefile, which Rocq 9.1 no longer ships
            (cd tests/lib && rocq makefile -f _CoqProject -o Makefile && make -j $NIX_BUILD_CORES)

            # some benchmarks (e.g. vs_hard) need a lot of stack to compile
            ulimit -s unlimited || true
            (cd tests/wasm && rocq c -R .. CertiRocq.Tests tests.v)

            runHook postBuild
          '';

          installPhase = ''
            runHook preInstall

            mkdir -p $out
            cp tests/wasm/CertiRocq.Tests.wasm.tests.*.wasm $out/
            test "$(ls $out | wc -l)" = "$(grep -c . tests/wasm/TESTS)"

            runHook postInstall
          '';
        };

      in
      {
        packages.default = certirocq;
        packages.wasm-benchmarks = wasm-benchmarks;

        devShells.default = pkgs.mkShell {
          name = "shell";
          packages = [
            certirocq
            rocq-core
            pkgs.wasm-tools
            pkgs.binaryen
            pkgs.nodejs_24
            wasmtime
            python3
            rocqPackages.vsrocq-language-server
          ];
          shellHook = ''
            echo "Entered nix shell."
          '';
        };
      }
    );
}
